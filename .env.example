# ─────────────────────────────────────────────────────────────────────────────
# Youth Club Library — Environment Variables Template
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to version control.
#
# ⚠️  SECURITY WARNING: Rotate any secrets that were ever committed to git
#     history immediately — old values are still visible in git log!
# ─────────────────────────────────────────────────────────────────────────────

# Django Core
# Generate a strong key: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-very-long-random-secret-key-here
DEBUG=False

# Allowed Hosts (comma-separated, no spaces)
# Example: ALLOWED_HOSTS=www.youthclublibrary.com,youthclublibrary.com
ALLOWED_HOSTS=localhost,127.0.0.1

# Google OAuth 2.0 Credentials
# Get from: https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# bKash Payment Number (shown on checkout pages — not a secret, but configurable)
BKASH_NUMBER=01700000000

# Email / SMTP Settings
# For Gmail: use an App Password, NOT your real account password
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=your-email@gmail.com

# Database (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Cloudinary (Media Storage in Production)
# Format: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://your-api-key:your-api-secret@your-cloud-name

# ScraperAPI (for competitor price scraping — optional)
# Get from: https://www.scraperapi.com/
SCRAPER_API_KEY=your-scraper-api-key

# Django Superuser (for auto-creation on Render during build — optional)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-this-strong-password
